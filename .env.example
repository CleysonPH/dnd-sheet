# Copie para .env e ajuste. O .env não é versionado.

# Postgres (usado pelo compose.yaml)
POSTGRES_USER=dnd
POSTGRES_PASSWORD=dnd
POSTGRES_DB=dnd_sheet

# Conexão da aplicação com o banco
DATABASE_URL=postgresql://dnd:dnd@localhost:5432/dnd_sheet

# Autenticação (Better Auth)
# Gere um segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Primeiro admin (usado só por `npm run db:seed`; pode ser removido depois)
SEED_ADMIN_NAME=Mestre
SEED_ADMIN_EMAIL=mestre@example.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# Envio de e-mail (link de redefinição de senha). Em desenvolvimento, o Mailpit
# do Compose (docker compose --profile dev up -d); os e-mails aparecem em
# http://localhost:8025. Em produção, o SMTP do provedor.
SMTP_HOST=localhost
SMTP_PORT=1025
# true para TLS direto (porta 465); com STARTTLS (porta 587), deixe false
SMTP_SECURE=false
# Usuário e senha do SMTP; deixe vazios para o Mailpit
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ficha D&D <ficha@localhost>"
